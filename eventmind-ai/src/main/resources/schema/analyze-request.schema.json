{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eventmind.ravi.dev/schema/analyze-request.schema.json",
  "title": "AnalyzeRequest",
  "description": "Request body accepted by POST /healing/analyze.",
  "type": "object",
  "additionalProperties": false,
  "required": ["symptom"],
  "properties": {
    "symptomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "symptom": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "logs": {
      "type": "string"
    },
    "jfrReport": {
      "type": "string"
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  }
}
