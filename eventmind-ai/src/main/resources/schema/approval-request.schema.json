{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eventmind.ravi.dev/schema/approval-request.schema.json",
  "title": "ApprovalRequest",
  "description": "Request body accepted by POST /healing/approve.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendationId", "decision", "approvedBy"],
  "properties": {
    "recommendationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "decision": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "RESERVED"]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "comment": {
      "type": "string",
      "maxLength": 500
    }
  }
}
