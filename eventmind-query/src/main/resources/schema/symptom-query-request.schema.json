{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eventmind.ravi.dev/schema/symptom-query-request.schema.json",
  "title": "SymptomQueryRequest",
  "description": "Query parameters accepted by GET /symptoms.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "page": {
      "type": "integer",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
