<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ravi</groupId>
        <artifactId>eventmind</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>eventmind-shared</artifactId>

    <name>eventmind-shared</name>
    <description>
        Shared objects for EventMind CQRS application
    </description>

    <dependencies>
        <!-- Axon messaging (serialization contracts: @Revision, event annotations).
             Version managed by the parent BOM. -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-messaging</artifactId>
        </dependency>

        <!-- Spring Boot auto-configuration support (shared AxonConfig registers via
             AutoConfiguration.imports). Version managed by the Spring Boot parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring context (annotations used by the shared AxonConfig) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Web (RFC-7807 ProblemDetail advice shared across modules) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- Spring AOP (the shared AuditAspect around @AuditLog methods; flows
             transitively into every module that depends on shared). Logging stays
             out - each module brings its own log4j2 stack. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- slf4j API (version managed by the parent BOM) for the shared audit
             aspect; the concrete binding is supplied by each module's logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Jackson databind (JSON schema validation) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Servlet API (shared CorrelationIdFilter; provided by the servlet container
             / embedded Tomcat of each web module at runtime) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-modelling</artifactId>
            <version>4.11.1</version>
            <scope>compile</scope>
        </dependency>

    </dependencies>

</project>